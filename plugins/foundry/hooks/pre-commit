#!/bin/sh
# Foundry pre-commit git hook - formats staged files with the repo's own prettier, so a
# commit never carries formatting drift for `lint` to reject at push or for `mise run fix`
# to rewrite later on an unrelated branch. The lint check stays the guarantee; this just
# means you rarely see it fail.
#
# Install (one of), from the repo to gate. The file is plugins/foundry/hooks/pre-commit in a
# cmaintz-skills clone, or ~/.claude/plugins/cache/cmaintz/foundry/<version>/hooks/pre-commit
# for plugin users:
#   cp <that path> .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
#   # or, to version it: git config core.hooksPath .githooks  (and put this there)
#
# No-op without a local node_modules/.bin/prettier or a Prettier config, so it's safe in
# any stack.
# Bypass once with: git commit --no-verify
[ -n "${CI:-}" ] && exit 0
cd "$(git rev-parse --show-toplevel)" || exit 0

bin=node_modules/.bin/prettier
if [ -x "$bin" ]; then prettier="$bin"
elif [ -f "$bin.cmd" ]; then prettier="$bin.cmd"
else exit 0
fi

git diff --cached --name-only --diff-filter=ACMR | while IFS= read -r f; do
  # Formatting a file with unstaged hunks and re-adding it would commit those hunks too.
  # Leave it as staged; `lint` catches any drift at push.
  if ! git diff --quiet -- "$f"; then
    echo "pre-commit: not formatting $f (it has unstaged changes)" >&2
    continue
  fi
  # Without a project config prettier applies its defaults, which restyles the repo.
  # "./" rather than `--`: after a `--` prettier drops --find-config-path and formats instead.
  if ! "$prettier" --find-config-path "./$f" >/dev/null 2>&1; then
    [ -n "${hinted:-}" ] || echo "pre-commit: no Prettier config, so staged files were not formatted; scaffold one matched to the repo's style with Foundry's scripts/prettier-config.mjs." >&2
    hinted=1
    continue
  fi
  "$prettier" --write --ignore-unknown --log-level warn -- "$f" >/dev/null && git add -- "$f"
done
exit 0
