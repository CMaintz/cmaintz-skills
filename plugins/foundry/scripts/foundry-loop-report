#!/usr/bin/env python3
"""foundry-loop-report - make the agent loop legible from verb telemetry.

Reads the JSONL emitted by foundry-verb-wrap (see designs/loop-telemetry.md) and
prints where the loop spends time, whether it is converging or thrashing, and how
each verb has been faring. Deterministic and offline; no model, no network.

Usage:
    foundry-loop-report [PATH]

PATH defaults to $FOUNDRY_TELEMETRY, then .foundry/telemetry.jsonl.

Scope: this summarises *verb* telemetry (timing, exit, scope, placement), derives a
thrash signal from pass->fail regressions, and trends the per-smell counts that
foundry-smells folds into each scan line under the `smells` task (gate, pre-push, CI).
The habit-hooks Stop hook does not feed those counts, so smell rounds run between gate
invocations are not in the series.
"""
import json
import os
import sys
from collections import defaultdict


def load(path):
    rows = []
    try:
        with open(path, encoding="utf-8") as fh:
            for line in fh:
                line = line.strip()
                if not line:
                    continue
                try:
                    rows.append(json.loads(line))
                except json.JSONDecodeError:
                    # A torn last line (crash mid-write) shouldn't sink the report.
                    continue
    except FileNotFoundError:
        return None
    return rows


def fmt_ms(ms):
    return f"{ms / 1000:.1f}s" if ms >= 1000 else f"{ms}ms"


def smell_trend(rows):
    """Per-smell convergence from the `smells` field foundry-smells folds into a scan's
    line. A smell whose count falls to zero (gone from a later scan) and then rises
    again has returned after being cleared - the structural analogue of a verb
    pass->fail regression, and the design's non-convergence signal.

    Only rows carrying `smells` are scans. A partial scan (its findings include
    `incomplete-run`) is dropped, not treated as zero: a missing scan would otherwise
    read as every smell cleared, then every smell back, a false return on each one.
    Returns {scans, partial, returned: {smell: times}, first, last} where first/last
    are the total smell counts of the first and last full scans (context only)."""
    scans, partial = [], 0
    for r in rows:
        s = r.get("smells")
        if not isinstance(s, dict):
            continue
        if "incomplete-run" in s:
            partial += 1
            continue
        scans.append(s)
    if not scans:
        return {"scans": 0, "partial": partial, "returned": {}, "first": 0, "last": 0}
    returned = {}
    for name in set().union(*scans):
        # unseen -> present -> cleared; a count seen again while cleared is a return. A
        # smell first appearing (unseen -> present) is scope growing, not a return.
        state = "unseen"
        for s in scans:
            if s.get(name, 0) > 0:
                if state == "cleared":
                    returned[name] = returned.get(name, 0) + 1
                state = "present"
            elif state == "present":
                state = "cleared"
    return {
        "scans": len(scans),
        "partial": partial,
        "returned": returned,
        "first": sum(scans[0].values()),
        "last": sum(scans[-1].values()),
    }


def main():
    path = (
        sys.argv[1] if len(sys.argv) > 1
        else os.environ.get("FOUNDRY_TELEMETRY", ".foundry/telemetry.jsonl")
    )
    rows = load(path)
    if rows is None:
        print(f"No telemetry at {path}. Run the gate once with foundry-verb-wrap wired in.")
        return 0
    if not rows:
        print(f"{path} is empty - nothing to report yet.")
        return 0

    rows.sort(key=lambda r: r.get("ms", 0))

    per = defaultdict(lambda: {"runs": 0, "fails": 0, "regress": 0, "total": 0, "last_ok": None})
    placements, scopes = defaultdict(int), defaultdict(int)
    for r in rows:
        v = r.get("verb", "?")
        st = per[v]
        st["runs"] += 1
        st["total"] += r.get("duration_ms", 0)
        ok = r.get("exit", 0) == 0
        if not ok:
            st["fails"] += 1
        # A pass followed later by a fail is a regression - the thrash signal.
        if st["last_ok"] is True and not ok:
            st["regress"] += 1
        st["last_ok"] = ok
        placements[r.get("placement", "?")] += 1
        scopes[r.get("scope", "?")] += 1

    total_ms = sum(s["total"] for s in per.values())
    first, last = rows[0].get("ts", "?"), rows[-1].get("ts", "?")
    lint_runs = per.get("lint", {}).get("runs", 0)

    print(f"Foundry loop report - {path}")
    print(f"Window: {first} -> {last}   ({len(rows)} verb runs"
          + (f", ~{lint_runs} gate attempts" if lint_runs else "") + ")")
    print()
    print("Per verb (by total time):")
    print(f"  {'verb':<12}{'runs':>5}{'fails':>6}{'regress':>8}{'total':>10}{'avg':>9}")
    for v, s in sorted(per.items(), key=lambda kv: kv[1]["total"], reverse=True):
        avg = s["total"] // s["runs"] if s["runs"] else 0
        print(f"  {v:<12}{s['runs']:>5}{s['fails']:>6}{s['regress']:>8}"
              f"{fmt_ms(s['total']):>10}{fmt_ms(avg):>9}")
    print()

    # Time sink.
    if total_ms:
        sink, ss = max(per.items(), key=lambda kv: kv[1]["total"])
        pct = 100 * ss["total"] / total_ms
        print(f"Time sink: {sink} ({fmt_ms(ss['total'])}, {pct:.0f}% of tracked verb time)")

    # Thrash / convergence.
    thrash = {v: s["regress"] for v, s in per.items() if s["regress"]}
    if thrash:
        detail = ", ".join(f"{v} x{n}" for v, n in sorted(thrash.items(), key=lambda kv: -kv[1]))
        print(f"Thrash: regressed after passing - {detail}. "
              f"Fixing one verb may be breaking another; stop and look before another round.")
    else:
        print("Thrash: none - no verb regressed after passing (loop looks convergent).")

    # Smell trend / convergence.
    st = smell_trend(rows)
    excl = (f" [{st['partial']} partial scan{'s' if st['partial'] != 1 else ''} excluded]"
            if st["partial"] else "")
    if st["scans"] == 0 and st["partial"]:
        print("Smells: not recorded - every smell scan was partial (incomplete-run); "
              f"nothing to trend{excl}.")
    elif st["scans"] == 0:
        print("Smells: not recorded - no scan wrote smell counts "
              "(smells not run under the wrapper, or foundry-smells not cached yet).")
    elif st["returned"]:
        detail = ", ".join(f"{name} cleared then returned x{n}"
                           for name, n in sorted(st["returned"].items(), key=lambda kv: (-kv[1], kv[0])))
        print(f"Smells: non-converging - {detail}. A cleared structural smell came back; "
              f"stop and look before another round{excl}.")
    else:
        trend = f"{st['scans']} scan{'s' if st['scans'] != 1 else ''}, {st['first']} -> {st['last']}"
        if st["last"] > st["first"]:
            # No return, but the count grew: usually new files entering the scanned scope
            # as the diff grows, not a regression. Don't call a rising count "converging".
            print(f"Smells: no return after clearing ({trend}){excl}. Count rose, likely "
                  f"new scope entering the scan rather than thrash.")
        else:
            print(f"Smells: converging - no smell returned after being cleared ({trend}){excl}.")

    # Latest snapshot.
    latest = {}
    for r in rows:
        latest[r.get("verb", "?")] = r.get("exit", 0) == 0
    red = [v for v, ok in latest.items() if not ok]
    print("Latest: " + ("all tracked verbs green" if not red else "still red -> " + ", ".join(red)))

    print(f"Placements: " + ", ".join(f"{k} {v}" for k, v in sorted(placements.items())))
    print(f"Scopes: " + ", ".join(f"{k} {v}" for k, v in sorted(scopes.items())))
    return 0


if __name__ == "__main__":
    sys.exit(main())
