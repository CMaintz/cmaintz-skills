#!/usr/bin/env python3
"""foundry-loop-report - make the agent loop legible from verb telemetry.

Reads the JSONL emitted by foundry-verb-wrap (see designs/loop-telemetry.md) and
prints where the loop spends time, whether it is converging or thrashing, and how
each verb has been faring. Deterministic and offline; no model, no network.

Usage:
    foundry-loop-report [--json] [PATH]

PATH defaults to $FOUNDRY_TELEMETRY, then .foundry/telemetry.jsonl. --json prints the
same summary as one JSON object (the plugin's MCP server reads it for gate_status):
per verb its runs, fails, regressions and last run, plus the still-red verbs and the
thrashing ones. A missing log is {"telemetry": null}.

Honest scope (v1): this summarises *verb* telemetry (timing, exit, scope,
placement) and derives a thrash signal from pass->fail regressions. Smell-trend
convergence needs smell counts, which the habit-hooks Stop hook will emit later
(a follow-on); until then this reports "thrash" from verb regressions only.
"""
import json
import os
import sys
from collections import defaultdict


def load(path):
    rows = []
    try:
        with open(path, encoding="utf-8") as fh:
            for line in fh:
                line = line.strip()
                if not line:
                    continue
                try:
                    rows.append(json.loads(line))
                except json.JSONDecodeError:
                    # A torn last line (crash mid-write) shouldn't sink the report.
                    continue
    except FileNotFoundError:
        return None
    return rows


def fmt_ms(ms):
    return f"{ms / 1000:.1f}s" if ms >= 1000 else f"{ms}ms"


def new_stats():
    return {"runs": 0, "fails": 0, "regress": 0, "total": 0, "last_ok": None, "last": None}


def tally(st, r):
    st["runs"] += 1
    st["total"] += r.get("duration_ms", 0)
    ok = r.get("exit", 0) == 0
    if not ok:
        st["fails"] += 1
    # A pass followed later by a fail is a regression - the thrash signal.
    if st["last_ok"] is True and not ok:
        st["regress"] += 1
    st["last_ok"] = ok
    st["last"] = {k: r.get(k) for k in ("ts", "exit", "scope", "placement", "rules") if k in r}


def summarise(rows):
    """Per-verb stats and placement/scope counts over rows sorted by start time."""
    rows = sorted(rows, key=lambda r: r.get("ms", 0))
    per = defaultdict(new_stats)
    placements, scopes = defaultdict(int), defaultdict(int)
    for r in rows:
        tally(per[r.get("verb", "?")], r)
        placements[r.get("placement", "?")] += 1
        scopes[r.get("scope", "?")] += 1
    return {"rows": rows, "per": per, "placements": placements, "scopes": scopes}


def red_verbs(per):
    return [v for v, s in per.items() if not s["last_ok"]]


def thrash_of(per):
    return {v: s["regress"] for v, s in per.items() if s["regress"]}


def as_json(path, summary):
    per = summary["per"]
    verbs = {v: {k: s[k] for k in ("runs", "fails", "regress", "last")} for v, s in per.items()}
    return {"telemetry": path, "verbs": verbs, "red": red_verbs(per), "thrash": thrash_of(per)}


def print_table(per):
    print("Per verb (by total time):")
    print(f"  {'verb':<12}{'runs':>5}{'fails':>6}{'regress':>8}{'total':>10}{'avg':>9}")
    for v, s in sorted(per.items(), key=lambda kv: kv[1]["total"], reverse=True):
        avg = s["total"] // s["runs"] if s["runs"] else 0
        print(f"  {v:<12}{s['runs']:>5}{s['fails']:>6}{s['regress']:>8}"
              f"{fmt_ms(s['total']):>10}{fmt_ms(avg):>9}")
    print()


def print_signals(per):
    total_ms = sum(s["total"] for s in per.values())
    if total_ms:
        sink, ss = max(per.items(), key=lambda kv: kv[1]["total"])
        pct = 100 * ss["total"] / total_ms
        print(f"Time sink: {sink} ({fmt_ms(ss['total'])}, {pct:.0f}% of tracked verb time)")
    thrash = thrash_of(per)
    if thrash:
        detail = ", ".join(f"{v} x{n}" for v, n in sorted(thrash.items(), key=lambda kv: -kv[1]))
        print(f"Thrash: regressed after passing - {detail}. "
              f"Fixing one verb may be breaking another; stop and look before another round.")
    else:
        print("Thrash: none - no verb regressed after passing (loop looks convergent).")
    red = red_verbs(per)
    print("Latest: " + ("all tracked verbs green" if not red else "still red -> " + ", ".join(red)))


def print_report(path, summary):
    rows, per = summary["rows"], summary["per"]
    lint_runs = per.get("lint", {}).get("runs", 0)
    print(f"Foundry loop report - {path}")
    print(f"Window: {rows[0].get('ts', '?')} -> {rows[-1].get('ts', '?')}   ({len(rows)} verb runs"
          + (f", ~{lint_runs} gate attempts" if lint_runs else "") + ")")
    print()
    print_table(per)
    print_signals(per)
    print("Placements: " + ", ".join(f"{k} {v}" for k, v in sorted(summary["placements"].items())))
    print("Scopes: " + ", ".join(f"{k} {v}" for k, v in sorted(summary["scopes"].items())))


def main(args):
    want_json = "--json" in args
    args = [a for a in args if a != "--json"]
    path = args[0] if args else os.environ.get("FOUNDRY_TELEMETRY", ".foundry/telemetry.jsonl")
    rows = load(path)
    if want_json:
        print(json.dumps(as_json(path, summarise(rows)) if rows is not None else {"telemetry": None}))
    elif rows is None:
        print(f"No telemetry at {path}. Run the gate once with foundry-verb-wrap wired in.")
    elif not rows:
        print(f"{path} is empty - nothing to report yet.")
    else:
        print_report(path, summarise(rows))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
