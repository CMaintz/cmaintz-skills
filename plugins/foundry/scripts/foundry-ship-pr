#!/usr/bin/env bash
# foundry-ship-pr - the one sanctioned path from a committed branch to an open PR.
#
# The guard-pr-create hook denies a bare `gh pr create` so no agent skips ship's gate,
# review and CI watch. This script is the sanctioned caller: a PreToolUse hook fires on
# the agent's OWN tool call (`bash .../foundry-ship-pr`), never on a subprocess, so the
# `gh pr create` run in here is unhooked - the script, not a forgeable token, is what
# carries the sanction, and it starts the CI watch itself so that step cannot be dropped
# either. It is idempotent and never prompts. Re-running it on a branch that already has a
# PR pushes any new commits and watches the checks of the commit it pushed.
#
# The repo is the current checkout's: the branch is pushed to `origin` and every gh call
# runs here, so gh resolves the same repo from that remote, from a linked worktree too.
#
#   Usage: foundry-ship-pr --body-file <path> [--title-file <path>] [--base <branch>]
#     Title defaults to HEAD's subject. Body and title come from FILES, never the command
#     line, so the PR prose can mention `gh pr create` without tripping the guard on the
#     agent's own invocation.
#   Watch: returns as soon as the PR is open; foundry-pr-watch --ready-on-green judges the
#          pushed commit's checks in the background and marks the draft ready on green. It
#          always runs as a hidden detached process logging to .foundry/pr-watch.log, never
#          in a Herdr pane, even inside Herdr. The log ends with
#          `---PR-CI-WATCH-DONE--- exit <n>`, n being foundry-pr-watch's exit (0 passed,
#          1 a check failed, 2 nothing to judge).
#   Exit:  0 the PR is open and the watch started; 2 a usage error; 3 the push was
#          rejected, so there is no CI run to watch.
set -euo pipefail

BASE=""; BODY_FILE=""; TITLE_FILE=""
while [ $# -gt 0 ]; do
  case "$1" in
    --base) BASE="$2"; shift 2 ;;
    --body-file) BODY_FILE="$2"; shift 2 ;;
    --title-file) TITLE_FILE="$2"; shift 2 ;;
    # Refused rather than threaded through: the push always goes to `origin`, so a gh-only
    # override would open or watch a PR on a repo the commit never reached.
    --repo)
      echo "foundry-ship-pr: --repo is not supported - the repo comes from the current checkout's" >&2
      echo "  origin remote (linked worktrees included); run this from that checkout" >&2
      exit 2 ;;
    *) echo "foundry-ship-pr: unknown arg: $1" >&2; exit 2 ;;
  esac
done
[ -n "$BODY_FILE" ] || { echo "foundry-ship-pr: --body-file is required (never interactive)" >&2; exit 2; }

here=$(cd "$(dirname "$0")" && pwd)
SENTINEL='---PR-CI-WATCH-DONE---'

default_base() { gh repo view --json defaultBranchRef -q .defaultBranchRef.name; }
existing_pr()  { gh pr view --json number -q .number 2> /dev/null; }

create_pr() { # open a draft PR for the pushed branch, echo its number
  local title branch
  if [ -n "$TITLE_FILE" ]; then title=$(head -n1 "$TITLE_FILE"); else title=$(git log -1 --format=%s); fi
  branch=$(git rev-parse --abbrev-ref HEAD)
  # --head explicitly: gh otherwise infers it from tracking config and can abort with
  # "you must first push the current branch" even right after a successful push -u.
  gh pr create --draft --head "$branch" --base "${BASE:-$(default_base)}" \
    --title "$title" --body-file "$BODY_FILE" > /dev/null
  existing_pr
}

# All three fds are redirected so the caller's tool call is not held open by the child.
watch_detached() { # <watch command> <log>
  nohup bash -c "$1" > "$2" 2>&1 < /dev/null &
  echo "foundry-ship-pr: CI watch running in the background; it is done when $2 ends with $SENTINEL"
}

# Push on every run, not only when creating: a re-launch after a fix commit must land it.
if ! git push -u origin HEAD >&2; then
  echo "foundry-ship-pr: push rejected - rebase or fix the branch, then re-run" >&2
  exit 3
fi
sha=$(git rev-parse HEAD)
pr=$(existing_pr || true)
[ -n "$pr" ] || pr=$(create_pr)
url=$(gh pr view "$pr" --json url -q .url)
root=$(git rev-parse --show-toplevel)
mkdir -p "$root/.foundry" && printf '%s\n' "$url" > "$root/.foundry/pr-url"
echo "foundry-ship-pr: PR $url"

# %q because the plugin path can contain spaces (a Windows profile like C:/Users/John Smith).
watch_cmd="$(printf '%q' "$here/foundry-pr-watch") $pr --sha $sha --ready-on-green; echo \"$SENTINEL exit \$?\""
watch_detached "$watch_cmd" "$root/.foundry/pr-watch.log"
