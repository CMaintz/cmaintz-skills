{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/hooks/guard-generated-files.sh", "timeout": 10 }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/hooks/guard-pr-create.sh", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/hooks/auto-format.sh", "timeout": 30 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/hooks/habit-hooks-guard.sh", "timeout": 120 },
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/hooks/typecheck-stop.sh", "timeout": 120 },
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/hooks/format-java-stop.sh", "timeout": 120 },
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/hooks/jev-toolcall-triage.sh", "timeout": 60 },
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/hooks/leash.sh hook", "timeout": 90 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/hooks/leash.sh snapshot", "timeout": 30 }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/hooks/leash.sh session", "timeout": 30 }
        ]
      }
    ]
  }
}
